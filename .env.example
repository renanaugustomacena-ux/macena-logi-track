# LogiTrack - environment variable template
# Copy this file to `.env` and adjust values for your environment.
# Never commit a populated .env file to version control.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development
APP_NAME=logitrack
APP_VERSION=0.2.0
APP_PORT=8080
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# HTTP / CORS / WebSocket
# Ports (Mission II contract):
#   frontend = 5174, backend = 8080, mongo = 27017, redis host = 6380
# -----------------------------------------------------------------------------
HTTP_CORS_ALLOWED=http://localhost:5174,http://127.0.0.1:5174
HTTP_TRUSTED_PROXIES=127.0.0.1
HTTP_WS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# -----------------------------------------------------------------------------
# MongoDB
# -----------------------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017
MONGO_DB=logitrack
MONGO_MAX_POOL=100
MONGO_MIN_POOL=5
MONGO_CONNECT_TIMEOUT=10s

# -----------------------------------------------------------------------------
# Redis (cache + pub/sub)
# Host-mapped on 6380 to avoid clashes with other local Redis installs.
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6380/0

# -----------------------------------------------------------------------------
# Authentication (JWT)
# In production generate a 256-bit random secret (`openssl rand -hex 32`).
# -----------------------------------------------------------------------------
JWT_SECRET=replace-me-with-a-real-256-bit-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
JWT_ISSUER=logitrack.it

# -----------------------------------------------------------------------------
# OpenTelemetry
# Leave OTEL_EXPORTER_OTLP_ENDPOINT empty to disable tracing in dev.
# -----------------------------------------------------------------------------
OTEL_SERVICE_NAME=logitrack-backend
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SAMPLE_RATIO=0.1

# -----------------------------------------------------------------------------
# OSRM route optimisation
# Point at a self-hosted instance in production to keep geolocation data
# inside the EU/Italian sovereign region.
# OSRM_ALLOWED_HOSTS is the SSRF guard: every outbound OSRM request is
# rejected unless the host matches one of these entries.
# -----------------------------------------------------------------------------
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_TIMEOUT=5s
OSRM_ALLOWED_HOSTS=router.project-osrm.org,osrm.logitrack.local
OSRM_CACHE_SIZE=1000
# OSRM_TRUCK_PROFILE: name of the OSRM profile to use when a request
# asks for vehicle="truck". The public OSRM service ships only the
# "driving" profile; production deployments serve a custom truck
# profile (e.g. "truck" or "hgv") with weight, height, hazardous-
# goods and ZTL awareness. When this is empty the optimiser falls
# back to "driving" and emits a one-shot WARN per process so the
# operator knows HGV restrictions are not being honoured.
OSRM_TRUCK_PROFILE=

# -----------------------------------------------------------------------------
# AIDA (Agenzia delle Dogane) customs integration
# The base URL and API key are issued per-operator after accreditation.
# -----------------------------------------------------------------------------
AIDA_API_BASE=
AIDA_API_KEY=

# -----------------------------------------------------------------------------
# RFI / FERTRAM intermodal rail-slot integration
# FERTRAM is the freight booking portal at the Quadrante Europa terminal.
# It is mTLS-protected in production: the operator must supply both
# LOGITRACK_RFI_MTLS_CERT_FILE and LOGITRACK_RFI_MTLS_KEY_FILE as
# absolute paths to PEM-encoded files. Supplying only one is a hard
# boot error (mTLS partial-config gives confusing 403s downstream).
# LOGITRACK_RFI_MTLS_CA_FILE is optional; leave empty to use the
# system root pool (production fertram.rfi.it is publicly signed).
# -----------------------------------------------------------------------------
LOGITRACK_RFI_API_BASE=
LOGITRACK_RFI_CLIENT_ID=
LOGITRACK_RFI_CLIENT_SECRET=
LOGITRACK_RFI_MTLS_CERT_FILE=
LOGITRACK_RFI_MTLS_KEY_FILE=
LOGITRACK_RFI_MTLS_CA_FILE=

# -----------------------------------------------------------------------------
# Kafka (placeholder - event streaming is a Phase 3 roll-out)
# -----------------------------------------------------------------------------
KAFKA_BROKERS=
KAFKA_TOPIC=logitrack.events.v1

# -----------------------------------------------------------------------------
# Geofence tile resolution (H3 resolution: 9 ~ 174 m hex edge)
# -----------------------------------------------------------------------------
GEOFENCE_TILE_RESOLUTION=9

# -----------------------------------------------------------------------------
# Rate limiting (HTTP) + WebSocket per-connection limiter
# -----------------------------------------------------------------------------
RATE_LIMIT_RPS=30
RATE_LIMIT_BURST=60
WS_RATE_LIMIT_RPS=20
WS_RATE_LIMIT_BURST=40
WS_IDLE_TIMEOUT=5m

# -----------------------------------------------------------------------------
# Identity backend (selects how /api/v1/auth/login resolves credentials)
#
# Values for LOGITRACK_IDENTITY_BACKEND:
#   memory   — in-process store seeded from the LOGITRACK_IDENTITY_DEMO_*
#              variables below. Leave USER and PASSWORD empty in
#              production and the store ships disabled (login returns
#              503 with a pointer to the IDP integration path).
#   disabled — refuse every login with 503. Use this when an external
#              IDP (Azure AD, Keycloak, Okta) is the single source of
#              truth; integrate via the IdentityStore interface in
#              backend/internal/handlers/auth.go.
#
# The DEMO_PASSWORD must be at least 12 characters per NIST SP 800-63B
# when set. Rotate it before any non-local deployment.
# -----------------------------------------------------------------------------
LOGITRACK_IDENTITY_BACKEND=memory
LOGITRACK_IDENTITY_DEMO_USER=
LOGITRACK_IDENTITY_DEMO_PASSWORD=
LOGITRACK_IDENTITY_DEMO_TENANT=demo-tenant
LOGITRACK_IDENTITY_DEMO_ROLES=operator

# -----------------------------------------------------------------------------
# Demo seed switch (populates tenant, 3 demo shipments, polylines)
# SEED_DEMO_TENANT must match LOGITRACK_IDENTITY_DEMO_TENANT so the
# demo user can read the seeded shipments.
# -----------------------------------------------------------------------------
SEED_DEMO=false
SEED_DEMO_TENANT=demo-tenant
