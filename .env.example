# LogiTrack — environment variable template
# Copy this file to `.env` and adjust values for your environment.
# Never commit a populated .env file to version control.
#
# This is a freelancer kit: every customer engagement = a fork of this
# repo with a per-customer .env. Treat each fork's .env as the single
# source of truth for that customer's deployment.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development
APP_NAME=logitrack
APP_VERSION=0.3.0
APP_PORT=8080
LOG_LEVEL=info
# AUDIT_MODE controls how the audit log is persisted.
#   async (default) — buffered channel + background writer. Lossy
#                     under sustained burst (records dropped + warn
#                     counter logged). Lowest latency on requests.
#   sync            — synchronous Mongo InsertOne in the request
#                     goroutine. ~1-3 ms latency per mutation. Choose
#                     this when the DPA / regulatory posture requires
#                     guaranteed audit retention (GDPR Art. 30).
AUDIT_MODE=async

# -----------------------------------------------------------------------------
# HTTP / CORS / WebSocket
# Ports: backend = 8080, frontend = 5174, mongo = 27017, redis host = 6380
# -----------------------------------------------------------------------------
HTTP_CORS_ALLOWED=http://localhost:5174,http://127.0.0.1:5174
HTTP_TRUSTED_PROXIES=127.0.0.1
HTTP_WS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# -----------------------------------------------------------------------------
# MongoDB
# DEV-ONLY DEFAULTS: rotate before any deployment.
# -----------------------------------------------------------------------------
MONGO_URI=mongodb://logitrack:devonly-rotate-before-deploy@localhost:27017/?authSource=admin
MONGO_DB=logitrack
MONGO_MAX_POOL=100
MONGO_MIN_POOL=5
MONGO_CONNECT_TIMEOUT=10s
MONGO_ROOT_USERNAME=logitrack
MONGO_ROOT_PASSWORD=devonly-rotate-before-deploy

# -----------------------------------------------------------------------------
# Redis (cache + pub/sub)
# Host-mapped on 6380 to avoid clashes with other local Redis installs.
# DEV-ONLY DEFAULTS: rotate before any deployment.
# -----------------------------------------------------------------------------
REDIS_URL=redis://default:devonly-rotate-before-deploy@localhost:6380/0
REDIS_PASSWORD=devonly-rotate-before-deploy

# -----------------------------------------------------------------------------
# Authentication (JWT, access tokens only)
# In production generate a 256-bit random secret: `openssl rand -hex 32`.
# The kit issues access tokens only — there is no refresh endpoint.
# Customers needing sliding sessions integrate their corporate IDP
# (Keycloak, Azure AD, Okta) at the IdentityStore seam in
# backend/internal/handlers/auth.go.
# -----------------------------------------------------------------------------
JWT_SECRET=replace-me-with-a-real-256-bit-secret
JWT_ACCESS_TTL=15m
JWT_ISSUER=logitrack.it

# -----------------------------------------------------------------------------
# OpenTelemetry
# Leave OTEL_EXPORTER_OTLP_ENDPOINT empty to disable tracing in dev.
# -----------------------------------------------------------------------------
OTEL_SERVICE_NAME=logitrack-backend
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SAMPLE_RATIO=0.1

# -----------------------------------------------------------------------------
# OSRM route optimisation (OPTIONAL)
#
# OSRM is opt-in. Leave OSRM_BASE_URL empty and the route optimiser
# falls back to a straight-line + 70 km/h estimate (good enough for
# demo and for customers that do not need turn-by-turn polylines).
#
# When you do wire OSRM, point at a self-hosted instance to keep
# geolocation data inside EU/Italian sovereignty. Public demo
# router.project-osrm.org is US-hosted with no SLA and no truck
# profile — never use in production.
#
# OSRM_ALLOWED_HOSTS is the SSRF guard: every outbound OSRM request
# is rejected unless the host matches one of these entries. The
# HTTP client refuses to follow redirects, so a compromised OSRM
# cannot escape the allow-list.
#
# OSRM_TRUCK_PROFILE: name of the OSRM profile when vehicle="truck".
# Production deployments serve a profile with HGV restrictions
# (weight, height, hazardous goods, ZTL). When empty, the optimiser
# falls back to "driving" and emits a one-shot WARN per process.
# -----------------------------------------------------------------------------
OSRM_BASE_URL=
OSRM_TIMEOUT=5s
OSRM_ALLOWED_HOSTS=
OSRM_CACHE_SIZE=1000
OSRM_TRUCK_PROFILE=

# -----------------------------------------------------------------------------
# Geofence tile resolution (H3 resolution: 9 ~ 174 m hex edge)
# -----------------------------------------------------------------------------
GEOFENCE_TILE_RESOLUTION=9

# -----------------------------------------------------------------------------
# Rate limiting (HTTP) + WebSocket per-connection limiter
# -----------------------------------------------------------------------------
RATE_LIMIT_RPS=30
RATE_LIMIT_BURST=60
WS_RATE_LIMIT_RPS=20
WS_RATE_LIMIT_BURST=40
WS_IDLE_TIMEOUT=5m

# -----------------------------------------------------------------------------
# Identity backend (selects how /api/v1/auth/login resolves credentials)
#
# Values for LOGITRACK_IDENTITY_BACKEND:
#   memory   — in-process store seeded from the LOGITRACK_IDENTITY_DEMO_*
#              variables below. Useful for demo and smoke tests.
#   disabled — refuse every login with 503. Use this when an external
#              IDP (Keycloak, Azure AD, Okta) is the single source of
#              truth; integrate via the IdentityStore interface in
#              backend/internal/handlers/auth.go.
#
# DEMO_PASSWORD must be >= 12 characters (NIST SP 800-63B). In
# production with the memory backend you must also set
# LOGITRACK_IDENTITY_DEMO_BREACH_ACK=true to acknowledge that you
# have verified the password against HIBP externally.
# -----------------------------------------------------------------------------
LOGITRACK_IDENTITY_BACKEND=memory
LOGITRACK_IDENTITY_DEMO_USER=
LOGITRACK_IDENTITY_DEMO_PASSWORD=
LOGITRACK_IDENTITY_DEMO_TENANT=demo-tenant
LOGITRACK_IDENTITY_DEMO_ROLES=operator,admin
LOGITRACK_IDENTITY_DEMO_BREACH_ACK=

# -----------------------------------------------------------------------------
# Demo seed switch (populates tenant + 3 demo shipments + rifiuti seeds)
# SEED_DEMO_TENANT must match LOGITRACK_IDENTITY_DEMO_TENANT so the
# demo user can read the seeded data.
# -----------------------------------------------------------------------------
SEED_DEMO=false
SEED_DEMO_TENANT=demo-tenant
